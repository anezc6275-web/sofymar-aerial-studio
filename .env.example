# Copia este archivo como .env (en la raíz del proyecto).
#
# MODO DE IA
# - Sin ANTHROPIC_API_KEY: modo SIMULADO (gratis). La Estación funciona con
#   análisis local de exposición y respuestas de ejemplo; no se llama a Claude.
# - Con ANTHROPIC_API_KEY: modo CLAUDE (consume créditos de pago de Anthropic).
ANTHROPIC_API_KEY=

# Modelo de Claude para análisis de fotogramas en vivo.
CLAUDE_MODEL=claude-opus-5-5

# Protección de gasto: máximo de llamadas a Claude por día (se reinicia a medianoche).
MAX_AI_CALLS_PER_DAY=200

# Puerto de la API local.
API_PORT=4000
